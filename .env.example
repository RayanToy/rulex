# Ключ Anthropic API. Получить: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Необязательно: адрес совместимого шлюза, если прямой доступ
# к api.anthropic.com недоступен. Пусто = официальный API.
ANTHROPIC_BASE_URL=

# Модель для всех этапов генерации. Сравнение моделей на этой задаче —
# eval/results/model-comparison.md.
RULEX_MODEL_GENERATION=claude-sonnet-5

# Каталог изменяемых данных (SQLite). В Docker сюда монтируется том.
RULEX_DATA_DIR=./var

# Логировать SQL-запросы (1/true). По умолчанию выключено.
RULEX_SQL_ECHO=

# Локальная модель вместо облака (для сравнения качества).
# RULEX_LLM_BACKEND=ollama переключает бэкенд, модель берётся
# из RULEX_MODEL_GENERATION (например ornith-1.5:9b).
# На машине с Ollama нужны OLLAMA_HOST=0.0.0.0:11434 и открытый
# порт 11434, иначе она слушает только 127.0.0.1.
RULEX_LLM_BACKEND=
RULEX_OLLAMA_HOST=http://localhost:11434

# Сколько слов генерировать параллельно. По умолчанию 1.
# Замер показал, что через совместимый шлюз параллелизм вредит
# (5 задач = впятеро дольше из-за троттлинга и ретраев), а локальная
# Ollama и так выполняет запросы по очереди. Повышать только
# против прямого API и только с замером.
RULEX_GEN_CONCURRENCY=1
