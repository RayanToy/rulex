# Ключ Anthropic API. Получить: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Необязательно: адрес совместимого шлюза, если прямой доступ
# к api.anthropic.com недоступен. Пусто = официальный API.
ANTHROPIC_BASE_URL=

# Модели. Тяжёлая — генерация толкований и дистракторов,
# дешёвая — массовая фильтрация слов-артефактов.
RULEX_MODEL_GENERATION=claude-opus-5
RULEX_MODEL_BULK=claude-haiku-4-5

# Каталог изменяемых данных (SQLite). В Docker сюда монтируется том.
RULEX_DATA_DIR=./var

# Логировать SQL-запросы (1/true). По умолчанию выключено.
RULEX_SQL_ECHO=
